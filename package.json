{
  "name": "prasad-transport-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "api": "node --expose-gc server/index.js",
    "api:dev": "node --expose-gc --watch server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:status": "node server/db/migrate.js --status",
    "db:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/pg-bootstrap.ps1",
    "agents:test": "node server/agents/selftest.js",
    "loans:selftest": "node server/lib/loanAmortiser.selftest.js",
    "ai:selftest": "node server/ai_engine/selftest.js",
    "agents:roster": "node -e \"import('./server/agents/registry.js').then(async m=>{const s=await m.initSwarm();console.table(s.agents.map(({id,codename,state,domain})=>({id,codename,state,domain})));process.exit(0)})\"",
    "db:load": "node server/db/seed/from-firestore.js",
    "db:load:dry": "node server/db/seed/from-firestore.js --dry-run",
    "sync:tunnel": "node scripts/sync-tunnel.cjs",
    "sync:tunnel:status": "node scripts/sync-tunnel.cjs --status",
    "db:migrate:cloud": "node server/db/migrate-cloud.js",
    "system:clean": "node scripts/tempPurge.cjs && node scripts/processCleaner.cjs",
    "system:kill-ghosts": "node scripts/sweepGhostApps.cjs",
    "ship": "node scripts/ship.mjs",
    "ship:watch": "node scripts/ship.mjs --watch",
    "ship:release": "node scripts/ship.mjs --release",
    "auth:selftest": "node server/lib/apiGuard.selftest.js",
    "wa:selftest": "node whatsapp-server/describeMedia.selftest.js",
    "places:selftest": "node src/lib/tripPlaces.selftest.mjs",
    "toll:selftest": "node src/lib/tollRoute.selftest.mjs",
    "migrate:selftest": "node server/db/migrations/148_toll_plaza_master.selftest.mjs",
    "migrate:selftest149": "node server/db/migrations/149_trip_expense_truth.selftest.mjs",
    "migrate:selftest150": "node server/db/migrations/150_fleet_card_statements.selftest.mjs",
    "fleetcard:selftest": "node server/lib/fleetCardImport.selftest.mjs",
    "check:refs": "node scripts/check-undefined-refs.mjs",
    "migrate:selftest151": "node server/db/migrations/151_agent_execution_logs.selftest.mjs",
    "nightly:selftest": "node server/lib/nightlyFuelSync.selftest.mjs",
    "migrate:selftest152": "node server/db/migrations/152_fleet_card_allocation.selftest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/client-sns": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@google/generative-ai": "^0.24.1",
    "@react-oauth/google": "^0.13.4",
    "axios": "^1.13.6",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fastify": "^5.11.3",
    "googleapis": "^171.4.0",
    "imapflow": "^1.4.7",
    "lucide-react": "^0.344.0",
    "mailparser": "^3.9.14",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^8.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-quill": "^2.0.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stream": "^0.0.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
