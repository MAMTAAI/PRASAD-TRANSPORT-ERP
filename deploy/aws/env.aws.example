# ============================================================================
# SERVER-SIDE .env for the AWS box — copy to /var/www/prasad-erp/.env
# (bridge.cjs reads this via dotenv). NEVER commit the filled-in copy.
# Copy the real secret values from the Windows PC's E:\PRASAD-TRANSPORT-ERP\.env
# ============================================================================

# Bridge port — must match ecosystem.prasad.config.cjs and the Nginx /ai/ proxy.
PORT=3100

# Shared local AI: Ollama running ON THIS SERVER. Both Prasad ERP and Jaiswal
# Capital route through this. (Jaiswal Capital can also call
# http://127.0.0.1:3100/api/chat directly with its own token — faster than
# going through the public tunnel.)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Accepted client tokens, comma-separated (token #1 = Prasad ERP front-end,
# token #2 = Jaiswal Capital). Copy the real values from the PC's .env.
PT_BRIDGE_TOKEN=<prasad-token>,<jaiswal-token>

# Browser origins allowed to call the bridge.
ALLOWED_ORIGINS=https://prasadtransport.com,https://www.prasadtransport.com,capacitor://localhost,http://localhost

# Optional feature keys (only needed if those bridge routes are used from AWS):
GEMINI_API_KEY=<copy-from-pc-if-used>
GOOGLE_TTS_API_KEY=<copy-from-pc-if-used>
# /upload-to-drive also needs google-key.json copied next to bridge.cjs.

# ============================================================================
# BUILD-TIME env — goes in .env.production.local on whichever machine runs
# `npm run build` for the AWS deployment (NOT read by the bridge):
#
#   VITE_LLM_BASE_URL=https://prasadtransport.com/ai
#   VITE_BRIDGE_URL=https://prasadtransport.com/ai
#   VITE_LLM_AUTH_TOKEN=<prasad-token>
#   VITE_LLM_MODEL=gemma4:e4b        # t3.large has 8GB RAM & no GPU — 12b will NOT fit
#   VITE_LLM_FALLBACK_MODEL=gemma4:e4b
#
# To keep the heavy gemma4:12b on the RTX 3060 PC instead, leave
# VITE_LLM_BASE_URL=https://ollama.prasadtransport.com (current production
# config) and skip the model downgrade — the AWS bridge is then unused by the
# ERP front-end but still serves Jaiswal Capital locally.
# ============================================================================
