<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false ON PURPOSE. Android's auto-backup copies the app's
         private storage to the user's Google Drive, and for a Capacitor app
         that private storage is the WebView's localStorage - which is where
         the ERP keeps the signed-in session token. Backing that up puts a
         working credential for the company books into a personal Drive, and
         restoring an old backup onto a new phone would silently resurrect a
         revoked session. There is nothing in this app worth restoring: it is
         a thin client, all state lives in PostgreSQL.

         usesCleartextTraffic=false is already the platform default at
         targetSdk 36, but it is stated here so that a future plugin's manifest
         merge cannot quietly re-enable plain HTTP. The API is HTTPS only. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Driver location. The duty screen calls navigator.geolocation, and
         Capacitor's WebView can only satisfy that if the permission is declared
         here AND granted at runtime. Without these two lines the call is denied
         silently, useGeoPolling falls back to its simulated NH-27 drift, and
         gpsEmitter correctly refuses to persist a simulated fix — so a Play
         Store build reports NO position at all while looking like it is
         tracking. Foreground only: the app tracks while the driver is on duty
         with the screen open, so ACCESS_BACKGROUND_LOCATION is deliberately NOT
         requested (it also triggers a separate Play review that this use does
         not need). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- GPS is how a truck is tracked, but a phone without it should still be
         able to run the office screens, so neither is required to install. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- NOT declared on purpose: CAMERA. Bill Scanner uses
         <input type="file" capture="environment">, which hands off to the
         system camera/picker app — the permission belongs to that app, not
         ours. Declaring it anyway would ask drivers for access we never use and
         add a permission Play asks us to justify. -->
</manifest>
