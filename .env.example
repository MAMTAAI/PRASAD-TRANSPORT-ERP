# ─────────────────────────────────────────────────────────────
# PRASAD ERP — environment config (copy to .env and fill in)
#
# Data layer: PostgreSQL only. Firebase/Firestore is being retired —
# see server/db/ for the schema and MIGRATION-FIREBASE-TO-POSTGRES.md
# for the cut-over plan.
# ─────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════
# 🗄️  DATABASE — PostgreSQL (the system of record)
#
# DB_TARGET picks the environment profile and the TLS default:
#   local → 127.0.0.1 postgres, TLS off
#   aws   → Amazon RDS,         TLS ON and certificate-verified
# ═════════════════════════════════════════════════════════════
DB_TARGET=local

# ── LOCAL DEVELOPMENT ────────────────────────────────────────
# One-time setup on the dev box (psql as the postgres superuser):
#   CREATE ROLE prasad_app WITH LOGIN PASSWORD 'choose-a-dev-password';
#   CREATE DATABASE prasad_erp OWNER prasad_app;
# Then:  node server/db/migrate.js
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=prasad_erp
PGUSER=prasad_app
PGPASSWORD=choose-a-dev-password

# ── AWS PRODUCTION (Amazon RDS for PostgreSQL) ───────────────
# On the EC2 box, set these INSTEAD of the PG* block above and flip
# DB_TARGET=aws. Keep RDS "Publicly accessible = No": the app reaches it over
# the private VPC subnet, with the EC2 security group as the only inbound rule
# on 5432. Nothing about the database should be reachable from the internet.
#
# DB_TARGET=aws
# PGHOST=prasad-erp-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
# PGPORT=5432
# PGDATABASE=prasad_erp
# PGUSER=prasad_app
# PGPASSWORD=<from AWS Secrets Manager — never hard-code in a file>
#
# TLS: download the RDS CA bundle once, then point at it. Without
# PGSSL_CA_PATH the connection is encrypted but UNVERIFIED (MITM-able) and
# pool.js will warn loudly on every boot.
#   curl -o certs/rds-global-bundle.pem \
#     https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# PGSSL=true
# PGSSL_CA_PATH=./certs/rds-global-bundle.pem
#
# Single-URL alternative — takes precedence over the PG* vars above:
# DATABASE_URL=postgresql://prasad_app:password@host:5432/prasad_erp

# ── Connection pool tuning (defaults are sane; override only if measured) ──
# PG_POOL_MAX=20                  # keep (instances × max) under the RDS cap
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=30000   # kills a runaway query before it pins a slot
# PG_SLOW_QUERY_MS=500            # log queries slower than this
# PG_APP_NAME=prasad-erp-api      # shows up in pg_stat_activity

# ═════════════════════════════════════════════════════════════
# 🌐 API SERVER (server/index.js — Fastify)
# ═════════════════════════════════════════════════════════════
API_PORT=3300
# Loopback by default; Nginx proxies to it. Only widen deliberately.
API_HOST=127.0.0.1
NODE_ENV=development
# Signs session JWTs. Generate a distinct one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-a-long-random-value
# How long a session lasts. Accepts 30s / 45m / 12h / 7d; bare digits = seconds.
# It sets BOTH halves of a session and they cannot drift: the JWT `exp` claim
# and the auth_sessions.expires_at row both come from issueToken()'s expiresAt,
# and requireAuth checks the row as well as the signature.
#
# CHANGING IT IS NOT RETROACTIVE. Sessions already issued keep the expires_at
# stamped at their login, so a raise only reaches somebody after they log in
# again. Production runs 24h (raised from 12h on 2026-09-01 to stop mid-day
# expiries for the admin team).
#
# ⚠️ IT IS ALSO NOT THE ONLY THING THAT ENDS A SESSION, and this is the usual
# source of "but I raised the TTL and still got logged out": a password change
# DELETES session rows outright — /password-reset/confirm and
# /users/:id/password kill every session for that user, /me/password kills every
# one except the caller's. That logout is deliberate and no TTL affects it.
JWT_TTL=24h
# bcrypt work factor for user password hashing (12 ≈ 250ms on t3.large).
BCRYPT_ROUNDS=12

# ═════════════════════════════════════════════════════════════
# 📦 Document storage (RC books, KYC, invoices, bill scans)
# Replaces Firebase Storage. Driver seam lives in server/lib/storage.js.
#
#   STORAGE_DRIVER=local   files under UPLOAD_DIR, served by GET /api/v1/files/*
#   STORAGE_DRIVER=s3      objects in S3_BUCKET, same route, same stored URLs
#
# Unset, the driver is inferred: s3 when S3_BUCKET *and* AWS_ACCESS_KEY_ID are
# both present, else local. Naming a bucket without credentials is how you get
# an upload path that fails only in production — so it stays local until both.
# ═════════════════════════════════════════════════════════════
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Local driver refuses to write below this much free space rather than filling
# a disk shared with the trading system.
LOCAL_MIN_FREE_MB=1024
UPLOAD_MAX_BYTES=26214400

# ── s3 driver ────────────────────────────────────────────────
# On EC2, attach an IAM ROLE to the instance and leave the two key vars unset:
# the SDK picks up role credentials automatically and no long-lived secret ever
# lands on disk. The access keys below are for LOCAL development only.
AWS_REGION=ap-south-1
S3_BUCKET=prasad-erp-documents
# Optional: one bucket, several environments (prasad/, staging/).
# S3_PREFIX=
# Local dev only — on EC2 use the instance IAM role instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Bucket must be created with public access fully blocked. Reads are proxied by
# GET /api/v1/files/* so they stay behind the app's own auth; the bucket needs
# no public-read policy. Presigned URLs (storage.presignGet) are for the rare
# direct-fetch case only.
S3_PRESIGN_TTL_SECONDS=900
#
# ⚠️ Switching local → s3 does NOT move existing objects. Sync UPLOAD_DIR into
# the bucket under the same keys first, or every link written before the switch
# 404s:  aws s3 sync ./uploads s3://$S3_BUCKET/ --sse AES256

# Google (the ONLY allowed external APIs in this project)
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 🤖 LOCAL LLM (Ollama + Gemma 4) — default engine, 100% local & free.
# Swap the model variant by editing VITE_LLM_MODEL only (no code changes).
VITE_LLM_PROVIDER=ollama
VITE_LLM_BASE_URL=http://localhost:11434
VITE_LLM_MODEL=gemma4:12b
VITE_LLM_FALLBACK_MODEL=gemma4:e4b
VITE_LLM_TEMPERATURE=0.4
VITE_LLM_TIMEOUT_MS=120000
VITE_LLM_EMBED_MODEL=nomic-embed-text

# ☁️ CLOUD AI (optional) — Bill Scanner ka "Cloud AI (Claude Haiku)" engine.
# Key SIRF bridge server (bridge.cjs) padhta hai — kabhi VITE_ prefix mat lagana,
# warna key browser bundle me chali jayegi!
ANTHROPIC_API_KEY=sk-ant-your-key-here
# claude-3-haiku-20240307 RETIRED ho chuka hai (Apr 2026) — current Haiku:
ANTHROPIC_MODEL=claude-haiku-4-5
# Ollama URL as seen FROM the bridge (local proxy mode ke liye)
OLLAMA_BASE_URL=http://localhost:11434

# ⚖️ HYBRID AI ROUTING (bridge.cjs) — halka/routine kaam on-box gemma pe
# rehta hai; bhaari reasoning Local Power PC (RTX 3060, DeepSeek-R1) pe jaata hai
# token-gated Cloudflare tunnel se. HEAVY path tabhi try hota hai jab
# OLLAMA_HEAVY_URL set ho — PC band ho to kaam on-box engine pe DEGRADE hota
# hai, marta nahi. Isliye ye sab optional hain: khali chhodo to sab kuch
# on-box gemma pe chalta rahega, jaise pehle.
#
# Heavy kab maana jaata hai: body.options.heavy === true, ya text
# OLLAMA_HEAVY_CHAR_THRESHOLD se lamba, ya usme analysis / reconcile / audit /
# ledger / forecast / hisaab / vishleshan jaisa kuch mile.
OLLAMA_HEAVY_URL=
OLLAMA_HEAVY_MODEL=
OLLAMA_HEAVY_TOKEN=
OLLAMA_LIGHT_MODEL=
OLLAMA_HEAVY_CHAR_THRESHOLD=1500

# Frontend -> bridge server URL (cloud AI + uploads isi se hokar jaate hain).
# LOCAL dev: http://localhost:3000. PRODUCTION (live site): apne Cloudflare
# Tunnel ka HTTPS URL daalein, e.g. https://ollama.prasadtransport.com
VITE_BRIDGE_URL=http://localhost:3000

# 🌐 SECURE TUNNEL — live HTTPS site apne PC ke Ollama tak isi se pahunchti hai.
# Poori setup ke liye: CLOUDFLARE-TUNNEL-SETUP.md
#
# (a) BRIDGE SIDE — accepted client secrets (comma-separated = multi-app).
#     Har app ka apna token; kisi ek ko rotate/revoke karna ho to baaki safe.
#     Strong random banayein:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     UNSET chhodne par gate OFF ho jata hai (sirf local-only dev ke liye).
PT_BRIDGE_TOKEN=prasad-transport-token-here,jaiswal-capital-token-here
#
# (b) BROWSER APPS jinhe allow karna hai (comma-separated). Server-to-server
#     callers (jaise Jaiswal Capital ka AWS backend) ko yahan add karne ki
#     zaroorat NAHI — unke paas Origin header hi nahi hota, sirf token chahiye.
#     ANDROID APP: Capacitor ka WebView origin `https://localhost` hai (port
#     ke bina). Ye entry hatane par Play Store build ki HAR request CORS par
#     ruk jaayegi, jabki browser bilkul theek chalta rahega — isliye ye
#     galti sirf phone par dikhti hai. `capacitor://localhost` iOS ka hai.
ALLOWED_ORIGINS=https://www.prasadtransport.com,https://prasadtransport.com,https://app.jaiswalcapital.com,http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost,http://localhost
#
# (c) FRONTEND SIDE — is app ka apna token (bridge ke PT_BRIDGE_TOKEN list me se
#     ek). Live build me hi set karein; local dev me khaali chalta hai.
#     ⚠️ Yeh browser bundle me embed hota hai — bots/random traffic rokta hai,
#     par asli secret vault nahi. Sabse strong gate = Cloudflare Access (doc).
VITE_LLM_AUTH_TOKEN=prasad-transport-token-here
#
# (d) LIVE SITE ke liye local engine ko tunnel URL par point karein (dev me
#     localhost:11434 rehne dein):
# VITE_LLM_BASE_URL=https://ollama.prasadtransport.com

# ─────────────────────────────────────────────────────────────
# 🛡️ P0 SECURITY HARDENING (2026-07-27)
# ─────────────────────────────────────────────────────────────
# Bridge bind address — DEFAULT is loopback (127.0.0.1). Nginx/cloudflared
# reach it via 127.0.0.1, so normal setups need NOTHING here. Only set
# HOST=0.0.0.0 if you deliberately want raw LAN/public exposure.
# HOST=127.0.0.1
#
# SOC Phase-0 event store (SQLite). Default: ./data/security-events.db
# SECURITY_DB_PATH=./data/security-events.db
#
# 🛡️ PHASE-1 ACTIVE DEFENSE — SHADOW by default (logs would-bans, blocks nothing).
# Flip SOC_ARM=1 ONLY after a clean shadow session (see deploy/PHASE1-ACTIVE-DEFENSE.md).
# App-layer 403 ban — instantly reversible (unset + restart), never touches iptables.
# SOC_ARM=0
# SOC_STRIKE_THRESHOLD=5

# -- LOCAL STORAGE ISOLATION (server/config/init_drives.js) ------------------
# Point document/log storage at a dedicated volume so the OS drive stays
# light. When set, init_drives.js verifies the volume exists at boot (refuses
# to boot if the drive is missing), creates uploads/ logs/ cache/ temp_bills/,
# and derives UPLOAD_DIR / OCR_UPLOAD_DIR / LOG_DIR for anything not set
# explicitly. Leave ALL of these unset to keep repo-relative paths (AWS).
# C: IS OFF-LIMITS FOR APPLICATION DATA (God rule 2026-08-15). On the office PC
# every PDF, bill, log and cache belongs on F:; Jaiswal Capital's models and
# tick data belong on H:. Never let either land on the OS drive.
# LOCAL_STORAGE_PATH=F:/Prasad_Transport_Data
# UPLOAD_DIR=F:/Prasad_Transport_Data/uploads
# LOG_DIR=F:/Prasad_Transport_Data/logs
# SOC_STRIKE_WINDOW_MIN=10
# Never-ban list (CSV): add Cloudflare egress, office IP, sibling infra IP BEFORE arming.
# SOC_IP_ALLOWLIST=
#
# FRONTEND — WhatsApp engine shared secret (matches WA_ENGINE_TOKEN in
# whatsapp-server/.env). Empty = gate off (engine is loopback-only anyway).
# VITE_WA_ENGINE_TOKEN=

# 📧 EMAIL BILL PARSER (email-parser.cjs) — email accounts .env me NAHI rehte;
# wo ERP ke "Email Bill Parser" screen (EMAIL_ACCOUNTS collection) me manage
# hote hain. Parser ANTHROPIC_API_KEY (upar) use karta hai. Chalane ke liye:
#   node email-parser.cjs          (scheduler — poll interval UI se set hota hai)
#   node email-parser.cjs --once   (single pass, cron/Task Scheduler ke liye)

# ── Machine callers ─────────────────────────────────────────────────────────
# A shared secret for callers that are not people: the WhatsApp engine posting
# chat history, and the unattended IOCL reconciler posting receipt vouchers.
# 48 random bytes; anything under 24 characters is treated as unset.
#
# It gates POST /api/v1/crm/chats and /crm/logs (server/lib/apiGuard.js) and is
# the second door on requireAdminOrService. Must match ERP_SERVICE_TOKEN in
# whatsapp-server/.env.
ERP_SERVICE_TOKEN=

# ── OTP delivery (2026-08-31: SMS fallback via AWS SNS) ─────────────────────
# whatsapp (default) | sms | auto (WhatsApp first, SMS when it cannot deliver)
# OTP_CHANNEL=auto
#
# STATUS ON PRODUCTION (verified 2026-09-01): the WhatsApp leg is live and
# linked (engine :5002, session "company"); the SNS leg is NOT configured —
# SMS_PROVIDER is unset, so `auto` is effectively WhatsApp-only today.
# @aws-sdk/client-sns is already installed on the box, so turning SNS on is a
# credential + DLT-registration job, not a deploy.
#
# Preferred: AWS SNS (box is on AWS — credential can be the EC2 instance role,
# needs sns:Publish). India = TRAI/DLT mandatory:
# SMS_PROVIDER=sns
# SMS_ENTITY_ID=                  # DLT Principal Entity id
# SMS_TEMPLATE_ID=                # DLT template id (also used by msg91)
# SMS_SENDER_ID=                  # DLT-approved 6-char header, e.g. PRASTR
# SNS_REGION=ap-south-1
# SMS_OTP_TEMPLATE=               # exact DLT-registered text with {code}
#
# BEFORE SETTING THE ABOVE, four things that are not env vars and will each
# fail silently or confusingly if skipped:
#
#  1. THERE IS NO EC2 INSTANCE ROLE ON THIS BOX. The line above says the
#     credential *can* be the instance role; as of 2026-09-01 it is not one —
#     IMDS /iam/security-credentials/ returns 404, i.e. nothing is attached.
#     Attach a role carrying sns:Publish (preferred, no key ever exists), or
#     fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. Without either,
#     every send throws SNS AuthorizationErrorException.
#  2. HALF-CONFIGURED READS AS UNCONFIGURED, AND SAYS NOTHING. smsConfigured()
#     requires BOTH SMS_ENTITY_ID and SMS_TEMPLATE_ID for sns — set one and the
#     SMS leg stays dark while `auto` keeps quietly succeeding over WhatsApp.
#  3. SNS STARTS IN THE SMS SANDBOX. Until the account is moved out, publishes
#     only reach verified destination numbers. Set a monthly spend limit at the
#     same time — SMS is the one channel here that costs money per send.
#  4. YOU CANNOT TEST SNS WITH OTP_CHANNEL=auto. `auto` only falls through to
#     SMS when WhatsApp *fails*, and WhatsApp is currently healthy — so the
#     test would pass having exercised nothing. Set OTP_CHANNEL=sms for the
#     live test, confirm the SMS arrives, then put it back to auto.
#
# After any change here: pm2 restart prasad-erp-api (dotenv reads .env once, at
# boot, from the process cwd /var/www/prasad-erp).
#
# Escape hatches: SMS_PROVIDER=fast2sms|msg91|custom
# SMS_API_KEY=                    # fast2sms authorization / msg91 authkey
# SMS_URL_TEMPLATE=               # custom: https://gw/send?to={mobile}&text={message}
