# ─────────────────────────────────────────────────────────────
# PRASAD ERP — environment config (copy to .env and fill in)
#
# Data layer: PostgreSQL only. Firebase/Firestore is being retired —
# see server/db/ for the schema and MIGRATION-FIREBASE-TO-POSTGRES.md
# for the cut-over plan.
# ─────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════
# 🗄️  DATABASE — PostgreSQL (the system of record)
#
# DB_TARGET picks the environment profile and the TLS default:
#   local → 127.0.0.1 postgres, TLS off
#   aws   → Amazon RDS,         TLS ON and certificate-verified
# ═════════════════════════════════════════════════════════════
DB_TARGET=local

# ── LOCAL DEVELOPMENT ────────────────────────────────────────
# One-time setup on the dev box (psql as the postgres superuser):
#   CREATE ROLE prasad_app WITH LOGIN PASSWORD 'choose-a-dev-password';
#   CREATE DATABASE prasad_erp OWNER prasad_app;
# Then:  node server/db/migrate.js
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=prasad_erp
PGUSER=prasad_app
PGPASSWORD=choose-a-dev-password

# ── AWS PRODUCTION (Amazon RDS for PostgreSQL) ───────────────
# On the EC2 box, set these INSTEAD of the PG* block above and flip
# DB_TARGET=aws. Keep RDS "Publicly accessible = No": the app reaches it over
# the private VPC subnet, with the EC2 security group as the only inbound rule
# on 5432. Nothing about the database should be reachable from the internet.
#
# DB_TARGET=aws
# PGHOST=prasad-erp-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
# PGPORT=5432
# PGDATABASE=prasad_erp
# PGUSER=prasad_app
# PGPASSWORD=<from AWS Secrets Manager — never hard-code in a file>
#
# TLS: download the RDS CA bundle once, then point at it. Without
# PGSSL_CA_PATH the connection is encrypted but UNVERIFIED (MITM-able) and
# pool.js will warn loudly on every boot.
#   curl -o certs/rds-global-bundle.pem \
#     https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# PGSSL=true
# PGSSL_CA_PATH=./certs/rds-global-bundle.pem
#
# Single-URL alternative — takes precedence over the PG* vars above:
# DATABASE_URL=postgresql://prasad_app:password@host:5432/prasad_erp

# ── Connection pool tuning (defaults are sane; override only if measured) ──
# PG_POOL_MAX=20                  # keep (instances × max) under the RDS cap
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=30000   # kills a runaway query before it pins a slot
# PG_SLOW_QUERY_MS=500            # log queries slower than this
# PG_APP_NAME=prasad-erp-api      # shows up in pg_stat_activity

# ═════════════════════════════════════════════════════════════
# 🌐 API SERVER (server/index.js — Fastify)
# ═════════════════════════════════════════════════════════════
API_PORT=3300
# Loopback by default; Nginx proxies to it. Only widen deliberately.
API_HOST=127.0.0.1
NODE_ENV=development
# Signs session JWTs. Generate a distinct one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-a-long-random-value
JWT_TTL=12h
# bcrypt work factor for user password hashing (12 ≈ 250ms on t3.large).
BCRYPT_ROUNDS=12

# ═════════════════════════════════════════════════════════════
# 📦 AWS S3 — document storage (RC books, KYC, invoices, bill scans)
#
# On EC2, attach an IAM ROLE to the instance and leave the two key vars unset:
# the SDK picks up role credentials automatically and no long-lived secret ever
# lands on disk. The access keys below are for LOCAL development only.
# ═════════════════════════════════════════════════════════════
AWS_REGION=ap-south-1
S3_BUCKET=prasad-erp-documents
# Local dev only — on EC2 use the instance IAM role instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Bucket must be created with public access fully blocked. Documents are served
# through short-lived presigned URLs, never as public objects.
S3_PRESIGN_TTL_SECONDS=900

# Google (the ONLY allowed external APIs in this project)
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 🤖 LOCAL LLM (Ollama + Gemma 4) — default engine, 100% local & free.
# Swap the model variant by editing VITE_LLM_MODEL only (no code changes).
VITE_LLM_PROVIDER=ollama
VITE_LLM_BASE_URL=http://localhost:11434
VITE_LLM_MODEL=gemma4:12b
VITE_LLM_FALLBACK_MODEL=gemma4:e4b
VITE_LLM_TEMPERATURE=0.4
VITE_LLM_TIMEOUT_MS=120000
VITE_LLM_EMBED_MODEL=nomic-embed-text

# ☁️ CLOUD AI (optional) — Bill Scanner ka "Cloud AI (Claude Haiku)" engine.
# Key SIRF bridge server (bridge.cjs) padhta hai — kabhi VITE_ prefix mat lagana,
# warna key browser bundle me chali jayegi!
ANTHROPIC_API_KEY=sk-ant-your-key-here
# claude-3-haiku-20240307 RETIRED ho chuka hai (Apr 2026) — current Haiku:
ANTHROPIC_MODEL=claude-haiku-4-5
# Ollama URL as seen FROM the bridge (local proxy mode ke liye)
OLLAMA_BASE_URL=http://localhost:11434

# Frontend -> bridge server URL (cloud AI + uploads isi se hokar jaate hain).
# LOCAL dev: http://localhost:3000. PRODUCTION (live site): apne Cloudflare
# Tunnel ka HTTPS URL daalein, e.g. https://ollama.prasadtransport.com
VITE_BRIDGE_URL=http://localhost:3000

# 🌐 SECURE TUNNEL — live HTTPS site apne PC ke Ollama tak isi se pahunchti hai.
# Poori setup ke liye: CLOUDFLARE-TUNNEL-SETUP.md
#
# (a) BRIDGE SIDE — accepted client secrets (comma-separated = multi-app).
#     Har app ka apna token; kisi ek ko rotate/revoke karna ho to baaki safe.
#     Strong random banayein:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     UNSET chhodne par gate OFF ho jata hai (sirf local-only dev ke liye).
PT_BRIDGE_TOKEN=prasad-transport-token-here,jaiswal-capital-token-here
#
# (b) BROWSER APPS jinhe allow karna hai (comma-separated). Server-to-server
#     callers (jaise Jaiswal Capital ka AWS backend) ko yahan add karne ki
#     zaroorat NAHI — unke paas Origin header hi nahi hota, sirf token chahiye.
ALLOWED_ORIGINS=https://www.prasadtransport.com,https://prasadtransport.com,https://app.jaiswalcapital.com,http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost
#
# (c) FRONTEND SIDE — is app ka apna token (bridge ke PT_BRIDGE_TOKEN list me se
#     ek). Live build me hi set karein; local dev me khaali chalta hai.
#     ⚠️ Yeh browser bundle me embed hota hai — bots/random traffic rokta hai,
#     par asli secret vault nahi. Sabse strong gate = Cloudflare Access (doc).
VITE_LLM_AUTH_TOKEN=prasad-transport-token-here
#
# (d) LIVE SITE ke liye local engine ko tunnel URL par point karein (dev me
#     localhost:11434 rehne dein):
# VITE_LLM_BASE_URL=https://ollama.prasadtransport.com

# ─────────────────────────────────────────────────────────────
# 🛡️ P0 SECURITY HARDENING (2026-07-27)
# ─────────────────────────────────────────────────────────────
# Bridge bind address — DEFAULT is loopback (127.0.0.1). Nginx/cloudflared
# reach it via 127.0.0.1, so normal setups need NOTHING here. Only set
# HOST=0.0.0.0 if you deliberately want raw LAN/public exposure.
# HOST=127.0.0.1
#
# SOC Phase-0 event store (SQLite). Default: ./data/security-events.db
# SECURITY_DB_PATH=./data/security-events.db
#
# 🛡️ PHASE-1 ACTIVE DEFENSE — SHADOW by default (logs would-bans, blocks nothing).
# Flip SOC_ARM=1 ONLY after a clean shadow session (see deploy/PHASE1-ACTIVE-DEFENSE.md).
# App-layer 403 ban — instantly reversible (unset + restart), never touches iptables.
# SOC_ARM=0
# SOC_STRIKE_THRESHOLD=5
# SOC_STRIKE_WINDOW_MIN=10
# Never-ban list (CSV): add Cloudflare egress, office IP, sibling infra IP BEFORE arming.
# SOC_IP_ALLOWLIST=
#
# FRONTEND — WhatsApp engine shared secret (matches WA_ENGINE_TOKEN in
# whatsapp-server/.env). Empty = gate off (engine is loopback-only anyway).
# VITE_WA_ENGINE_TOKEN=

# 📧 EMAIL BILL PARSER (email-parser.cjs) — email accounts .env me NAHI rehte;
# wo ERP ke "Email Bill Parser" screen (EMAIL_ACCOUNTS collection) me manage
# hote hain. Parser ANTHROPIC_API_KEY (upar) use karta hai. Chalane ke liye:
#   node email-parser.cjs          (scheduler — poll interval UI se set hota hai)
#   node email-parser.cjs --once   (single pass, cron/Task Scheduler ke liye)
